<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RCTUAssetBridge</AssemblyName>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <IlcGenerateStackTraceData>true</IlcGenerateStackTraceData>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UAssetAPI/UAssetAPI.csproj" AdditionalProperties="RCTNativeBridge=true" />
    <!-- JSON contains polymorphic library types. Preserve their reflection metadata. -->
    <TrimmerRootAssembly Include="UAssetAPI" />
    <IlcArg Include="--substitution:$(MSBuildProjectDirectory)/Aot.Substitutions.xml" />
  </ItemGroup>
</Project>
